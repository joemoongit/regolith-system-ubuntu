#!/bin/sh
set -e

# Remove the Xorg config written by regolith-raspberrypi-xorg.service, unless
# it was edited by hand.
case "$1" in
remove | purge)
	conf=/etc/X11/xorg.conf.d/99-regolith-raspberrypi.conf
	if [ -f "$conf" ] && [ "$(head -n 1 "$conf")" = "# Generated by regolith-raspberrypi-xorg.service" ]; then
		rm -f "$conf"
	fi
	;;
esac

#DEBHELPER#

exit 0
