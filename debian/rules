#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# debhelper before 13.14 (Ubuntu 22.04) only enables units found in
# lib/systemd/system; later versions also look in usr/lib/systemd/system.
UNITDIR ?= $(shell dpkg --compare-versions "$$(dpkg-query -W -f='$${Version}' debhelper)" ge 13.14~ && echo usr/lib/systemd/system || echo lib/systemd/system)

%:
	dh $@

# The Raspberry Pi Xorg config service only does anything on Raspberry Pi
# hardware, so only ship it in the arm64 package.
override_dh_install:
ifeq ($(DEB_HOST_ARCH),arm64)
	dh_install usr/libexec/regolith-system-ubuntu/raspberrypi-xorg-config usr/libexec/regolith-system-ubuntu/
	dh_install usr/lib/systemd/system/regolith-raspberrypi-xorg.service $(UNITDIR)/
else
	dh_install
endif
