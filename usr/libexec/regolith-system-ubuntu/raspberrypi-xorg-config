#!/bin/sh
# Tell Xorg which DRM device drives the Raspberry Pi's display.
#
# A Raspberry Pi has more than one DRM device. If Xorg picks one that does not
# drive the display (such as v3d, which only renders), lightdm shows a black
# screen with a blinking cursor. The display device is:
#
#   - vc4 for HDMI, and for every display on a Pi 4 and earlier.
#   - On a Pi 5, an RP1 device (drm-rp1-dsi, drm-rp1-dpi or drm-rp1-vec) for a
#     DSI display (ribbon cable), a DPI display (GPIO header) or composite
#     video. These devices only exist when the display is enabled in
#     /boot/firmware/config.txt, so if one exists, it is the display to use.
#
# Xorg makes the first device that matches any "PrimaryGPU" OutputClass its
# primary GPU, so this writes a single section, chosen at every boot. On other
# hardware it removes the file.
#
# REGOLITH_ROOT prefixes every path, for testing.

set -eu

root=${REGOLITH_ROOT:-}
conf="$root/etc/X11/xorg.conf.d/99-regolith-raspberrypi.conf"
marker="# Generated by regolith-raspberrypi-xorg.service"

dt_compatible() {
	[ -r "$root/proc/device-tree/compatible" ] &&
		tr '\0' '\n' < "$root/proc/device-tree/compatible" | grep -qx "$1"
}

ours() {
	[ -f "$conf" ] && [ "$(head -n 1 "$conf")" = "$marker" ]
}

if ! dt_compatible 'raspberrypi,.*'; then
	if ours; then
		rm -f "$conf"
	fi
	exit 0
fi

if [ -e "$conf" ] && ! ours; then
	echo "$conf was edited by hand (its first line is not \"$marker\"); leaving it alone" >&2
	exit 0
fi

# RP1 display drivers are modules that udev loads; wait until they have probed.
if dt_compatible 'brcm,bcm2712'; then
	udevadm settle --timeout=10 || true
fi

identifier=vc4
match_driver=vc4
for driver in "$root"/sys/class/drm/card*/device/driver; do
	[ -L "$driver" ] || continue
	case $(basename "$(readlink "$driver")") in
	drm-rp1-dsi | drm-rp1-dpi | drm-rp1-vec)
		identifier=rp1
		match_driver="drm-rp1-dsi|drm-rp1-dpi|drm-rp1-vec"
		;;
	esac
done

if [ -e "$root/etc/X11/xorg.conf.d/99-v3d.conf" ]; then
	echo "$root/etc/X11/xorg.conf.d/99-v3d.conf (from gldriver-test) can pick a different primary GPU; remove gldriver-test and that file" >&2
fi

mkdir -p "$(dirname "$conf")"
cat > "$conf.tmp" << EOF
$marker
# It rewrites this file at every boot. To keep your own changes, delete the
# first line.
Section "OutputClass"
  Identifier "$identifier"
  MatchDriver "$match_driver"
  Driver "modesetting"
  Option "PrimaryGPU" "true"
EndSection
EOF
mv -f "$conf.tmp" "$conf"
